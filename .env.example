# Salesforce Connected App Configuration
CLIENT_ID='your_salesforce_connected_app_client_id_here'
CLIENT_SECRET='your_salesforce_connected_app_secret_here'

# OAuth Redirect URI (default for local development)
# For production: https://your-domain.com/oauth2/callback
REDIRECT_URI='http://localhost:3000/oauth2/callback'

# Salesforce API Documentation Version
# Update to match your Salesforce org's API version
DOC_VERSION='255.0'

# Chrome Extension ID (for development)
# Update after loading unpacked extension in Chrome
CHROME_ID='dmlgjapbfifmeopbfikbdmlgdcgcdmfb'

# Server Port (optional, defaults to 3000)
# PORT=3000

# Node Environment (development|production)
# Automatically set by npm scripts, usually don't need to change
# NODE_ENV=development
